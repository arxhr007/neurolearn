# Copy to .env.local to override. Both settings are optional.

# Origin of the NeuroLearn API.
# Leave empty (the default) to call /api/... on the same origin — this is what
# you want for `npm run dev` (Vite proxies it) and for the Docker image (nginx
# proxies it). Only set this if the API is served from a different origin,
# e.g. https://api.example.com — in which case the backend's CORS_ORIGINS_RAW
# must also list this app's origin.
VITE_API_BASE_URL=

# Where `npm run dev` forwards /api requests. Change if your backend is not on
# port 8000.
VITE_DEV_API_TARGET=http://localhost:8000

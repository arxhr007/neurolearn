# Copy this file to .env and fill in values for your environment.
#   cp .env.example .env
#
# docker compose reads this file from the repo root. When running the backend
# directly (without Docker), either this file or backend/.env works — a
# backend/.env takes precedence.

# Required for tutor responses.
GROQ_API_KEY=

# Required for story generation, text-to-speech, and memory transcription.
gemini_api_key=
GEMINI_MODEL=gemini-3.1-flash-lite
STORY_PROVIDER=gemini

# API auth. Change this before deploying anywhere real.
JWT_SECRET_KEY=change-this-in-production

# Optional API settings.
API_LOG_LEVEL=info

# Origins allowed to call the API directly. Not needed for the Docker setup,
# where nginx serves the app and the API on a single origin, but required if
# you point a separately hosted frontend at this backend.
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:5173,http://localhost:8000
